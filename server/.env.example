# Backend Environment Variables (Render Web Service)

# Server Port (Set dynamically by Render)
PORT=3001
HOST=0.0.0.0

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/soundabode?retryWrites=true&w=majority

# Preset Admin and Faculty Passcodes
ADMIN_PASSCODE=YourSecureAdminPasscode123!
ASHU_PASSCODE=AshuPasscode123!
VAIBHAV_PASSCODE=VaibhavPasscode123!

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=https://soundabode.com,https://www.soundabode.com,https://soundabode.pages.dev

# Google Sheets Webhook URL for lead forwarding
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycb.../exec

# ─── Meta Conversions API (CAPI) ────────────────────────────────────────────
# Required to send CRM lead-stage events to Meta Events Manager.
# Generate your access token from:
#   Meta Events Manager -> Your Dataset (976314001636856) -> Settings -> Generate Token
META_ACCESS_TOKEN=your_meta_access_token_here

# Your Meta Pixel / Dataset ID (already configured in metaCapi.js as default)
META_DATASET_ID=976314001636856

# Optional: Test event code for sandbox validation
# Get this from: Meta Events Manager -> Your Dataset -> Test Events tab
META_TEST_EVENT_CODE=TEST12345

# ─── Meta Lead Ads Webhook ──────────────────────────────────────────────────
# Required to automatically capture native Facebook & Instagram Lead Ad form submissions.
# 1. Custom verify token you configure in Meta App Dashboard -> Webhooks:
META_WEBHOOK_VERIFY_TOKEN=soundabode_leads_2024
# 2. Meta App Secret from Meta Developer Dashboard -> App Settings -> Basic:
META_APP_SECRET=your_meta_app_secret_here
# 3. Facebook Page Access Token with 'leads_retrieval' and 'pages_manage_metadata' permissions:
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
